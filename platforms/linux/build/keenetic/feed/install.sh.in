#!/bin/sh
# Mesh Town for Keenetic (Entware): adds the package feed of this router's architecture and installs the node.
# Usage: wget -O- @BASE@/install.sh | sh
# MESHTOWN_FEED overrides the feed address (mirrors, testing).
set -e
BASE="${MESHTOWN_FEED:-@BASE@}"
OPKG=/opt/bin/opkg
[ -x "$OPKG" ] || { echo "meshtown: $OPKG not found: install Entware first" >&2; exit 1; }
TMPD="$(mktemp -d)"
trap 'rm -rf "$TMPD"' EXIT

# The feed directory is named after the Entware architecture: the last part of the "src/gz entware" address.
URL="$(sed -n 's/^src\/gz[[:space:]][[:space:]]*entware[[:space:]][[:space:]]*//p' /opt/etc/opkg.conf | head -n 1)"
URL="${URL%%[[:space:]]*}"
URL="${URL%/}"
ARCH="${URL##*/}"
[ -n "$ARCH" ] || { echo "meshtown: no 'src/gz entware' line in /opt/etc/opkg.conf" >&2; exit 1; }

# The default Entware wget cannot open https: install the ssl one first (as the nfqws-keenetic instructions do).
ensure_https() {
	case "$BASE" in https:*) ;; *) return 1 ;; esac
	"$OPKG" update || true
	"$OPKG" install ca-certificates wget-ssl
	"$OPKG" remove wget-nossl || true
}

fetch_index() {
	wget -q -O "$TMPD/Packages.gz" "$BASE/$ARCH/Packages.gz"
}

# The feed has to carry this architecture before any configuration is touched.
if ! fetch_index && ! { ensure_https && fetch_index; }; then
	echo "meshtown: no packages for $ARCH ($BASE/$ARCH/Packages.gz)" >&2
	echo "meshtown: see the manual install steps in the project README" >&2
	exit 2
fi
echo "meshtown: Entware architecture $ARCH"

mkdir -p /opt/etc/opkg
echo "src/gz meshtown $BASE/$ARCH" > /opt/etc/opkg/meshtown.conf
"$OPKG" update || echo "meshtown: opkg update reported errors (other feeds?), continuing" >&2
if "$OPKG" list-installed meshtown 2>/dev/null | grep -q '^meshtown '; then
	"$OPKG" upgrade meshtown
else
	"$OPKG" install meshtown
fi
echo "meshtown: installed; the node page is http://<router address>:7777/ from the home network"
