#!/bin/sh /etc/rc.common
# Autostart of a Mesh Town node under procd (OpenWrt 24.10, aarch64).
# Tested in an emulator; installation — platforms/linux/build/openwrt/README.md.
START=99
STOP=01
USE_PROCD=1

PROG=/usr/bin/meshtown
CONF_DIR=/etc/meshtown
CONF="$CONF_DIR/config.json"

# The exit role comes from config.json (exit.enabled, default true): the router works as an exit for other
# members, the checkbox on the node page toggles it. The exit does not let traffic through to private addresses, the home
# network or the router itself. --no-exit or --exit here would pin the role over the file (the checkbox would stop
# working); after a change — restart.
EXIT_FLAG=

# Proxy and PAC for home network devices (earlier --no-socks was used).
# There is no flag: enabled state and access come from config.json — socks.enabled=true, socks.access=localnet
# (port 1080 listens on the br-lan network too, PAC — http://<router address on br-lan>:1080/proxy.pac).
# Inbound from wan is closed by the OpenWrt firewall (zone wan: input REJECT) and, on top of it, by the interface list
# socks.ifaces/web.ifaces (see start_service: br-lan seeding; without a list the node's automation cuts WAN off). --no-socks
# here would turn the proxy off over the file.
SOCKS_FLAG=

start_service() {
	[ -x "$PROG" ] || { logger -t meshtown "no $PROG, not starting"; return 1; }
	mkdir -p "$CONF_DIR" && chmod 0700 "$CONF_DIR"

	# Seeding the list of interfaces allowed to the proxy and the page: the subcommand writes the lan device (usually br-lan)
	# into socks.ifaces and web.ifaces ONCE — only if the file has neither key (--if-unset).
	# After that the node page or 'meshtown ifaces' makes the choice; the list has no start flags. The device is
	# network.lan.device (OpenWrt 21.02+), for 19.07 the bridge network.lan.type=bridge → br-lan. If not found —
	# no seeding, the node's automation works. A subcommand error does not stop the start.
	LAN_DEV="$(uci -q get network.lan.device)"
	[ -z "$LAN_DEV" ] && [ "$(uci -q get network.lan.type)" = bridge ] && LAN_DEV=br-lan
	[ -n "$LAN_DEV" ] && { "$PROG" ifaces --config "$CONF" --if-unset "$LAN_DEV" 2>&1 | logger -t meshtown; }

	procd_open_instance
	# explicit 'run': the default of a tray build is 'tray', and without a screen it exits with code 1
	procd_set_param command "$PROG" run --config "$CONF" $EXIT_FLAG $SOCKS_FLAG
	procd_set_param env NO_COLOR=1
	# threshold_s pause_s attempts: a failure faster than 60 s counts as consecutive, after 10–11 such restarts in a row procd gives up on the node
	# (crash loop); lived longer than 60 s — the counter resets, restart after 5 s
	procd_set_param respawn 60 5 10
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 15
	procd_set_param nice 10
	# the exit holds one descriptor per proxied connection; default 1024
	procd_set_param limits nofile="4096 4096"
	procd_close_instance
}
